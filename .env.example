# Environment variable template — COPY this file to .env and fill in real values.
# NEVER commit the real .env file. It is excluded by .gitignore.

# ── Gemini AI Financial Advisor ──────────────────────────────────────────────
# Get a free key (no credit card required) at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Gmail Password Recovery (optional) ───────────────────────────────────────
# Enable two-step verification on Gmail before creating an App Password.
# Leave these blank if you do not need the Forgot Password email flow.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
